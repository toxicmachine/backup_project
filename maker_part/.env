# родительская директория для резервных копий
BACKUPS_DIR='F:\\BackUPs'
# родительская директория проекта
PROJECT_DIR='F:\\BackUPs_Maker'
# название модуля(директории) с файлами конфигураций резервного копирования для баз данных
CONFIG_DIRS='databases'
# запускать или нет создание резервных копий
BACKUPS_MAKER=True

# параметры подключения к серверу
DATABASE_HOST='hostname'
# DATABASE_USER и DATABASE_PASSWORD имеет смысл добавить в системные переменные, python-decouple читает сначала оттуда
DATABASE_USER='database_user'
DATABASE_PASSWORD="password"
# список баз, в порядке выполнения резервных копий
DATABASE_LIST='gilev, book, ostosk, extpdtest, sud, testarm_kassir, testztos, testbtos, ulcb, testfltm, testflcb'

# настройки отправки в rabbitmq
RABBIT_HOST='hostname'
RABBIT_PORT='port'
# RABBIT_USERNAME и RABBIT_PASSWORD имеет смысл добавить в системные переменные, python-decouple читает сначала оттуда
RABBIT_USERNAME='user'
RABBIT_PASSWORD='password'
RABBIT_EXCHANGE='exchange'
RABBIT_VIRTUAL_HOST='/'
RABBIT_PUSH_QUEUE='queue_name'

# настройки для отправки e-mail уведомлений
EMAIL_DOMAIN='domain'
EMAIL_HOST='hostname'
EMAIL_PORT=465
# EMAIL_USER и EMAIL_PASS имеет смысл добавить в системные переменные, python-decouple читает сначала оттуда
EMAIL_USER='email_user'
EMAIL_PASS='password'
EMAIL_INFO_MESSAGE='Сводная таблица выполненных действий на сервере DATABASE_HOST.'
EMAIL_NOTIFY_LIST='example1@example.ru, example2@example.ru'