# родительская директория проекта
PROJECT_DIR='/home/backup_keeper/auto_copying'

# запускать или нет копирование резервных копий
BACKUP_KEEPER=True

# данные пользователя на линукс UID И GID пользователя
MOUNT_USER_UID=1001
MOUNT_USER_GID=1001

# диск для монтирования
MOUNT_DISK='/dev/mapper/mpatha2'
# директория для монтирования диска
MOUNT_DIR='/storage_shd'

# родительская директория, откуда идет копирование резервных копий
SOURCE_DIR='/storage_shd/BackUPs'
# родительская директория, куда будут копироваться резервные копии
DESTINATION_DIR='/storage_big/S1CBD'

# настройки чтения с rabbitmq
RABBIT_HOST='hostname'
RABBIT_PORT='port'
RABBIT_USERNAME='user'
RABBIT_PASSWORD='password'
RABBIT_EXCHANGE='exchange'
RABBIT_VIRTUAL_HOST='/'
RABBIT_PUSH_QUEUE='queue_name'

# настройки для отправки e-mail уведомлений
EMAIL_DOMAIN='domain'
EMAIL_HOST='hostname'
EMAIL_PORT=465
EMAIL_USER='email_user'
EMAIL_PASS='password'
EMAIL_INFO_MESSAGE='Сервер KeeperBU информирует об операциях с БД '
EMAIL_NOTIFY_LIST='example1@example.ru, example2@example.ru'